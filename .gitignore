# Universal Telegram Mini App (TMA) E-Commerce — Git Ignore Rules

# Dependencies
/node_modules
/.pnpm
/.yarn

# Next.js Build & Cache
/.next/
/out/
/.vercel

# Environment & Secrets
.env
.env*.local
!.env.example

# Uploaded Files
/public/uploads/*
!/public/uploads/.gitkeep

# IDE & OS Files
.DS_Store
*.pem
.idea/
.vscode/

# Build & TypeScript Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tsconfig.tsbuildinfo

.vercel
