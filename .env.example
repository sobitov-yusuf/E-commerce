# Universal Telegram Mini App (TMA) E-Commerce — Environment Variables Template
# Copy this file to .env and fill in your actual production credentials

# 🐘 PostgreSQL Database Connection URL (with PgBouncer support)
DATABASE_URL="postgresql://tma_user:tma_password@localhost:5432/tma_ecommerce?schema=public"

# 🤖 Telegram Bot Credentials (from @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_ADMIN_CHAT_ID="-1001234567890"

# 🔑 Auth & JWT Session Secret
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# 🔴 Upstash Redis (Rate Limiting, Stock Lock, JWT Blacklist)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# 🌐 Application Public Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot_username"

# 💳 Payment Providers Configuration (Click & Payme)
CLICK_MERCHANT_ID="your_click_merchant_id"
CLICK_SERVICE_ID="your_click_service_id"
CLICK_SECRET_KEY="your_click_secret_key"

PAYME_MERCHANT_ID="your_payme_merchant_id"
PAYME_SECRET_KEY="your_payme_secret_key"

# 🤖 Google Gemini AI (1-Click Auto Product Translation & Generation)
GEMINI_API_KEY="your_gemini_api_key_here"
