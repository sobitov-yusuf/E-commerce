// Universal Telegram Mini App (TMA) E-Commerce — Prisma Database Schema
// Database: PostgreSQL with JSONB i18n & GIN Indexing support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum LanguageCode {
  uz
  ru
  en
}

enum ProductBadge {
  NEW
  TOP
  SALE
  NONE
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderStatus {
  NEW
  PROCESSING
  DELIVERING
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  CLICK
  PAYME
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryType {
  COURIER
  PICKUP
}

enum TransactionType {
  PAYMENT
  REFUND
}

enum PaymentProvider {
  CLICK
  PAYME
  STARS
  CASH
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  SUPERADMIN
  MANAGER
}

// ==========================================
// MODELS
// ==========================================

/// 1. Users (Telegram Xaridorlari)
model User {
  id            String       @id @default(uuid()) @db.Uuid
  telegram_id   BigInt       @unique
  first_name    String
  last_name     String?
  username      String?
  phone         String?
  language_code LanguageCode @default(uz)
  is_blocked    Boolean      @default(false)
  created_at    DateTime     @default(now())

  cart_items          CartItem[]
  orders              Order[]
  user_promocodes     UserPromocode[]
  reviews             Review[]
  wishlists           Wishlist[]
  stock_notifications StockNotification[]

  @@map("users")
}

/// 2. Categories (Kategoriyalar - Multilingual JSONB)
model Category {
  id        Int     @id @default(autoincrement())
  name      Json    // { uz: "Kiyim", ru: "Одежда", en: "Clothing" }
  slug      String  @unique
  image_url String?
  is_active Boolean @default(true)

  products Product[]

  @@map("categories")
}

/// 3. Products (Mahsulotlar - Multilingual JSONB & GIN Search)
model Product {
  id          Int          @id @default(autoincrement())
  category_id Int
  name        Json         // { uz: "Futbolka", ru: "Футболка", en: "T-Shirt" }
  description Json         // { uz: "...", ru: "...", en: "..." }
  base_price  Decimal      @db.Decimal(12, 2)
  old_price   Decimal?     @db.Decimal(12, 2)
  badge       ProductBadge @default(NONE)
  images      String[]
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())

  category            Category            @relation(fields: [category_id], references: [id], onDelete: Cascade)
  variants            ProductVariant[]
  banners             Banner[]
  cart_items          CartItem[]
  order_items         OrderItem[]
  reviews             Review[]
  wishlists           Wishlist[]
  stock_notifications StockNotification[]

  @@map("products")
}

/// 4. ProductVariants (Mahsulot Variantlari va Ombor Qoldig'i - SKU)
model ProductVariant {
  id          Int      @id @default(autoincrement())
  product_id  Int
  size        String?
  color       String?
  price       Decimal? @db.Decimal(12, 2)
  image_url   String?
  stock_count Int      @default(0)
  sku         String?  @unique

  product             Product             @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cart_items          CartItem[]
  order_items         OrderItem[]
  stock_notifications StockNotification[]

  @@map("product_variants")
}

/// 5. Banners (Bosh sahifadagi Bannerlar - Multilingual JSONB)
model Banner {
  id              Int      @id @default(autoincrement())
  title           Json     // { uz: "Yangi To'plam", ru: "Новая Коллекция", en: "New Collection" }
  image_url       String
  link_product_id Int?
  is_active       Boolean  @default(true)
  sort_order      Int      @default(0)

  link_product Product? @relation(fields: [link_product_id], references: [id], onDelete: SetNull)

  @@map("banners")
}

/// 6. CartItems (Savat elementlari)
model CartItem {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.Uuid
  product_id Int
  variant_id Int?
  quantity   Int
  updated_at DateTime @updatedAt

  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

/// 7. Promocodes (Promokodlar)
model Promocode {
  id               Int          @id @default(autoincrement())
  code             String       @unique
  discount_type    DiscountType
  discount_value   Decimal      @db.Decimal(12, 2)
  min_order_amount Decimal?     @db.Decimal(12, 2)
  max_uses         Int?
  used_count       Int          @default(0)
  expires_at       DateTime?
  is_active        Boolean      @default(true)

  user_promocodes UserPromocode[]
  orders          Order[]

  @@map("promocodes")
}

/// 8. UserPromocodes (Promokod Suiiste'moli Nazorati - Transit Table)
model UserPromocode {
  id           Int      @id @default(autoincrement())
  user_id      String   @db.Uuid
  promocode_id Int
  used_at      DateTime @default(now())

  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  promocode Promocode @relation(fields: [promocode_id], references: [id], onDelete: Cascade)

  @@unique([user_id, promocode_id])
  @@map("user_promocodes")
}

/// 9. Orders (Buyurtmalar, Geolokatsiya & Statuslar)
model Order {
  id             Int           @id @default(autoincrement())
  order_number   String        @unique
  user_id        String        @db.Uuid
  promocode_id   Int?
  branch_id      Int?
  status         OrderStatus   @default(NEW)
  payment_type   PaymentType
  payment_status PaymentStatus @default(PENDING)
  subtotal_price Decimal       @db.Decimal(12, 2)
  discount_price Decimal       @default(0) @db.Decimal(12, 2)
  delivery_price Decimal       @default(0) @db.Decimal(12, 2)
  total_price    Decimal       @db.Decimal(12, 2)
  customer_name  String
  customer_phone String
  delivery_type  DeliveryType
  address        String?
  latitude       Decimal?      @db.Decimal(10, 8)
  longitude      Decimal?      @db.Decimal(11, 8)
  comment        String?
  created_at     DateTime      @default(now())

  user         User          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  promocode    Promocode?    @relation(fields: [promocode_id], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  order_items  OrderItem[]
  transactions Transaction[]

  @@map("orders")
}

/// 10. Transactions (Moliyaviy Audit & Immutable Ledger)
model Transaction {
  id               Int               @id @default(autoincrement())
  order_id         Int
  parent_id        Int?
  transaction_type TransactionType   @default(PAYMENT)
  provider         PaymentProvider
  transaction_id   String
  amount           Decimal           @db.Decimal(12, 2)
  status           TransactionStatus @default(PENDING)
  reason           String?
  perform_time     DateTime?
  created_at       DateTime          @default(now())

  order              Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  parent_transaction Transaction?  @relation("TransactionParent", fields: [parent_id], references: [id], onDelete: SetNull)
  child_transactions Transaction[] @relation("TransactionParent")

  @@map("transactions")
}

/// 11. OrderItems (Buyurtma Tarkibi)
model OrderItem {
  id             Int      @id @default(autoincrement())
  order_id       Int
  product_id     Int
  variant_id     Int?
  quantity       Int
  price          Decimal  @db.Decimal(12, 2)
  selected_size  String?
  selected_color String?

  order   Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@map("order_items")
}

/// 12. Reviews (Sharhlar va Moderatsiya)
model Review {
  id         Int          @id @default(autoincrement())
  user_id    String       @db.Uuid
  product_id Int
  rating     Int
  comment    String?
  images     String[]
  status     ReviewStatus @default(PENDING)
  created_at DateTime     @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("reviews")
}

/// 13. Wishlists (Sevimlilar Ro'yxati)
model Wishlist {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.Uuid
  product_id Int
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@map("wishlists")
}

/// 14. Branches (Do'kon Filiallari - Samovivoz)
model Branch {
  id        Int      @id @default(autoincrement())
  name      Json     // { uz: "Chilonzor filiali", ru: "Чиланзарский филиал", en: "Chilanzar branch" }
  address   Json     // { uz: "...", ru: "...", en: "..." }
  phone     String?
  lat       Decimal? @db.Decimal(10, 8)
  lng       Decimal? @db.Decimal(11, 8)
  is_active Boolean  @default(true)

  orders Order[]

  @@map("branches")
}

/// 15. StockNotifications (Mavjud Bo'lganda Bildirishnoma)
model StockNotification {
  id          Int      @id @default(autoincrement())
  user_id     String   @db.Uuid
  product_id  Int
  variant_id  Int?
  is_notified Boolean  @default(false)
  created_at  DateTime @default(now())

  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@map("stock_notifications")
}

/// 16. StoreSettings (White-Label Do'kon Sozlamalari)
model StoreSetting {
  id                      Int      @id @default(autoincrement())
  store_name              Json     // { uz: "...", ru: "...", en: "..." }
  logo_url                String?
  currency                String   @default("UZS")
  delivery_fee            Decimal  @default(0) @db.Decimal(12, 2)
  free_delivery_threshold Decimal? @db.Decimal(12, 2)
  phone_number            String?
  terms_url               Json?    // { uz: "...", ru: "...", en: "..." }
  is_active               Boolean  @default(true)

  @@map("store_settings")
}

/// 17. Admins (Adminlar va Menejerlar)
model Admin {
  id          Int       @id @default(autoincrement())
  telegram_id BigInt    @unique
  name        String
  role        AdminRole @default(MANAGER)
  is_active   Boolean   @default(true)

  admin_logs AdminLog[]

  @@map("admins")
}

/// 18. AdminLogs (Admin Harakatlari Tarixi - Audit Log)
model AdminLog {
  id         Int      @id @default(autoincrement())
  admin_id   Int
  action     String
  details    Json?
  created_at DateTime @default(now())

  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}
